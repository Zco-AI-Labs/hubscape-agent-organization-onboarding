{
  "type": "container",
  "props": {
    "className": "flex flex-col gap-4 p-4 bg-white rounded-lg border border-pink-100"
  },
  "children": [
    {
      "type": "input",
      "props": {
        "name": "full_name",
        "label": "Contact Person Full Name",
        "placeholder": "Alex Doe",
        "inputType": "text"
      }
    },
    {
      "type": "input",
      "props": {
        "name": "contact_email",
        "label": "Contact Email Address",
        "placeholder": "alex@apex.com",
        "inputType": "text"
      }
    },
    {
      "type": "phone",
      "props": {
        "name": "mobile_number",
        "label": "Personal Contact Mobile Number",
        "placeholder": "(123) 456 7890",
        "inputType": "text"
      }
    },
    {
      "type": "button",
      "props": {
        "label": "Submit Contact Details",
        "actionUrl": "agent://sales-onboarding-agent/save_personal_details",
        "styling": {
          "colorTheme": "pink"
        },
        "submittedLabel": "Contact Details Submitted",
        "closeOnClick": true
      }
    },
    {
      "type": "button",
      "props": {
        "label": "Cancel",
        "actionUrl": "client://close_widget?text=Contact+details+form+cancelled.",
        "styling": {
          "colorTheme": "slate"
        },
        "hideOnSubmit": true
      }
    }
  ]
}
