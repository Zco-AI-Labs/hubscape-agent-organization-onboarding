{
  "type": "container",
  "props": {
    "className": "flex flex-col gap-4 p-4 bg-white rounded-lg border border-pink-100"
  },
  "children": [
    {
      "type": "input",
      "props": {
        "name": "full_name",
        "label": "Contact Person Full Name",
        "placeholder": "Alex Doe",
        "inputType": "text"
      }
    },
    {
      "type": "input",
      "props": {
        "name": "contact_email",
        "label": "Contact Email Address",
        "placeholder": "alex@apex.com",
        "inputType": "text"
      }
    },
    {
      "type": "input",
      "props": {
        "name": "mobile_number",
        "label": "Personal Contact Mobile Number",
        "placeholder": "+15550199000",
        "inputType": "text"
      }
    },
    {
      "type": "button",
      "props": {
        "label": "Submit Contact Details",
        "actionUrl": "agent://submit_personal",
        "styling": {
          "colorTheme": "pink"
        }
      }
    },
    {
      "type": "button",
      "props": {
        "label": "Cancel",
        "actionUrl": "client://close_widget?text=Form+cancelled",
        "styling": {
          "colorTheme": "slate"
        }
      }
    }
  ]
}
