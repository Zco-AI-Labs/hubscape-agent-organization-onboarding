{
  "type": "container",
  "props": {
    "className": "flex flex-col gap-4 p-4 bg-white rounded-lg border border-blue-200"
  },
  "children": [
    {
      "type": "phone",
      "props": {
        "name": "mobile_number",
        "label": "Personal Contact Mobile Number",
        "placeholder": "(123) 456 7890",
        "inputType": "text"
      }
    },
    {
      "type": "button",
      "props": {
        "label": "Send Verification Code",
        "actionUrl": "agent://sales-onboarding-agent/send_mobile_otp",
        "styling": {
          "colorTheme": "blue"
        },
        "submittedLabel": "Code Sent",
        "closeOnClick": true
      }
    },
    {
      "type": "button",
      "props": {
        "label": "Cancel",
        "actionUrl": "client://close_widget?text=Verification+cancelled",
        "styling": {
          "colorTheme": "slate"
        },
        "hideOnSubmit": true
      }
    }
  ]
}