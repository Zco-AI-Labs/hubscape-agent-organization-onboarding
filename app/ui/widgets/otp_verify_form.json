{
  "type": "container",
  "props": {
    "className": "flex flex-col gap-2 p-4 bg-white rounded-lg border border-blue-200"
  },
  "children": [
    {
      "type": "input",
      "props": {
        "name": "otp_code",
        "label": "Enter 6-digit Verification Code",
        "placeholder": "123456",
        "inputType": "text"
      }
    },
    {
      "type": "button",
      "props": {
        "label": "Verify OTP",
        "actionUrl": "agent://sales-onboarding-agent/check_mobile_otp",
        "styling": {
          "colorTheme": "blue"
        },
        "submittedLabel": "OTP Verified",
        "closeOnClick": true
      }
    },
    {
      "type": "button",
      "props": {
        "label": "Cancel",
        "actionUrl": "client://close_widget?text=Form+cancelled",
        "styling": {
          "colorTheme": "slate"
        },
        "hideOnSubmit": true
      }
    }
  ]
}